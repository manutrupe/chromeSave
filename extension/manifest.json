{
  "manifest_version": 3,
  "name": "ChromeSave – Fingerprint & Face Lock",
  "short_name": "ChromeSave",
  "version": "1.1.0",
  "description": "Lock the websites you choose (like your email) behind Windows Hello or Touch ID.",
  "minimum_chrome_version": "122",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ChromeSave",
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "pages/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "storage",
    "tabs",
    "webNavigation",
    "alarms",
    "idle"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pages/lock.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
