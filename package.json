{
  "name": "chromesave",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension that locks chosen websites behind Windows Hello / Touch ID.",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/e2e.mjs",
    "package": "cd extension && zip -r ../chromesave.zip . -x '.*'"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
